<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" tools:context=".DashboardActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDashboard"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/imageViewBackDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_back"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                app:tint="?attr/colorOnPrimary" /> <TextView
            android:id="@+id/textViewToolbarTitleDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Painel de Controle"
            android:textColor="?attr/colorOnPrimary" android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center_horizontal" />
            <View
                android:layout_width="48dp"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDashboard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Período:"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp"
                    android:textColor="?attr/colorOnBackground"/> <Spinner
                android:id="@+id/spinnerPeriodFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:backgroundTint="?attr/colorSecondaryContainer"/> <ImageView
                android:id="@+id/imageViewRefreshDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_refresh"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Atualizar"
                android:layout_marginStart="8dp"
                app:tint="?attr/colorOnBackground" /> </LinearLayout>

            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="space_around"
                app:alignContent="flex_start">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorPrimaryContainer"> <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_shopping_bag"
                        android:contentDescription="Ícone Pedidos"
                        app:tint="?attr/colorOnPrimaryContainer" /> <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total de Pedidos"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnPrimaryContainer" android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/textViewTotalPedidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimaryContainer" android:layout_marginTop="4dp" />
                </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorSecondaryContainer"> <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_person"
                        android:contentDescription="Ícone Clientes"
                        app:tint="?attr/colorOnSecondaryContainer" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total de Clientes"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/textViewTotalClientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorTertiaryContainer"> <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_payments"
                        android:contentDescription="Ícone Vendas"
                        app:tint="?attr/colorOnTertiaryContainer" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total de Vendas"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/textViewTotalVendas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0.00"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorErrorContainer"> <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_remove_shopping_cart"
                        android:contentDescription="Ícone Custo"
                        app:tint="?attr/colorOnErrorContainer" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custo Total"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/textViewCustoTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0.00"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorSecondaryContainer"> <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_trending_up"
                        android:contentDescription="Ícone Lucro"
                        app:tint="?attr/colorOnSecondaryContainer" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lucro Total"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/textViewLucroTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0.00"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorTertiaryContainer"> <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_delivery_dining"
                        android:contentDescription="Ícone Entregas"
                        app:tint="?attr/colorOnTertiaryContainer" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Próximas Entregas"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/textViewProximasEntregas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEstoque"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorPrimaryContainer"> <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_product"
                        android:contentDescription="Ícone Estoque"
                        app:tint="?attr/colorOnPrimaryContainer" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Produtos em Estoque"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/textViewTotalProdutosEstoque"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorSurfaceVariant"> <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_monetization_on"
                        android:contentDescription="Ícone Valor Estoque"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Valor Total do Estoque"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/textViewValorTotalEstoque"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0.00"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMateriais"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_flexBasisPercent="45%"
                    app:layout_flexGrow="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    android:layout_margin="8dp"
                    android:backgroundTint="?attr/colorTertiaryContainer"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_construction"
                            android:contentDescription="Ícone Materiais"
                            app:tint="?attr/colorOnTertiaryContainer" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Materiais / Insumos"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnTertiaryContainer"
                            android:layout_marginTop="8dp" />
                        <TextView
                            android:id="@+id/textViewTotalMateriais"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ver Itens"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnTertiaryContainer"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </com.google.android.flexbox.FlexboxLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Produtos Mais Vendidos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:textColor="?attr/colorOnBackground"/> <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTopSellingProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_top_selling_product" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>