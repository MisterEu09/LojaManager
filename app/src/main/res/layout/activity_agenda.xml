<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".AgendaActivity">

    <RelativeLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imageViewBackAgenda"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnPrimary"
            android:contentDescription="Voltar" />

        <TextView
            android:id="@+id/textViewToolbarTitleAgenda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/imageViewBackAgenda"
            android:text="Agenda de Entregas"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/topInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbarLayout"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewPedidosPendentesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X Entregas Agendadas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorSecondary"
            android:layout_marginBottom="8dp"
            tools:text="10 Entregas Agendadas" /> <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Spinner
            android:id="@+id/spinnerPeriodSelection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/period_options"
            android:backgroundTint="?attr/colorOnBackground"
            android:popupBackground="?attr/colorSurface"
            style="@style/Widget.AppCompat.Spinner.Underlined" />

        <ImageView
            android:id="@+id/imageViewPreviousPeriod"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="4dp"
            android:layout_marginStart="16dp"
            app:tint="?attr/colorOnBackground"
            android:contentDescription="Período Anterior" />

        <TextView
            android:id="@+id/textViewCurrentPeriod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="07 de Julho de 2025"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorOnBackground" />

        <ImageView
            android:id="@+id/imageViewNextPeriod"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_right"
            android:padding="4dp"
            app:tint="?attr/colorOnBackground"
            android:contentDescription="Próximo Período" />
    </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAgendaPedidos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topInfoLayout"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        tools:listitem="@layout/item_agenda_pedido" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddEntrega"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add"
        app:tint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        android:contentDescription="Adicionar Nova Entrega" />

</RelativeLayout>