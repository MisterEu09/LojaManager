<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/rounded_border"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/imageViewAnalysisIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Ícone de Sugestão"
        android:src="@drawable/ic_check_circle"
        app:tint="?attr/colorPrimary" /> <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textViewAnalysisProductName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome do Produto"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" /> <TextView
    android:id="@+id/textViewAnalysisProductDetails"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Cód: ABC | Vendido: 0x"
    android:textSize="14sp"
    android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="2dp" />

</LinearLayout>

    <TextView
        android:id="@+id/textViewAnalysisSuggestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MANTER"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary" android:layout_marginStart="16dp" />

</LinearLayout>