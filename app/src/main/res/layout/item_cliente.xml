<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/textViewNomeRazaoSocial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome/Razão Social do Cliente"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" /> <TextView
    android:id="@+id/textViewCnpjCpfCliente"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="CNPJ/CPF: 000.000.000-00"
    android:textSize="16sp"
    android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/textViewTelefoneCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tel: (XX) XXXX-XXXX"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/textViewEnderecoCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Endereço: Rua Alguma, 123 - Bairro - Cidade/UF"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="2dp" />

</LinearLayout>