<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface"> <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Filtrar Produtos por:"
    android:textSize="20sp"
    android:textStyle="bold"
    android:textColor="?attr/colorOnSurface"
    android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Código Exato do Produto"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:hintTextColor="?attr/colorOnSurfaceVariant"
        app:boxStrokeColor="?attr/colorOnSurfaceVariant"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextExactProductCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categoria:"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spinnerFilterCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:backgroundTint="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Marca:"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spinnerFilterBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:backgroundTint="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonClearProductSelectionFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Limpar Todos os Filtros"
        android:layout_gravity="end"
        style="?attr/materialButtonOutlinedStyle"
        android:textColor="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary" />


</LinearLayout>

