<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewCodigoPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Código: #001"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" /> <TextView
        android:id="@+id/textViewClienteNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cliente: Nome do Cliente"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/textViewDataCompraPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data da Compra: DD/MM/AAAA"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/textViewValorTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor: R$ 0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/textViewDataEntregaPrevista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrega Prevista: DD/MM/AAAA"
            android:textSize="14sp"
            android:textColor="?attr/colorTertiary" android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Situação: PENDENTE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_background_pending"
            android:textColor="?attr/colorOnPrimary" /> </LinearLayout>

    <ImageView
        android:id="@+id/imageViewMoreOptionsPedido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_more_vert"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_gravity="top"
        android:contentDescription="Mais opções"
        app:tint="?attr/colorOnSurfaceVariant" /> </LinearLayout>