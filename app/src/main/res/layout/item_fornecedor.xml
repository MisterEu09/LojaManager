<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/textViewRazaoSocial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Razão Social do Fornecedor"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" /> <TextView
    android:id="@+id/textViewCnpjCpf"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="CNPJ/CPF: 00.000.000/0000-00"
    android:textSize="16sp"
    android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/textViewTelefoneFornecedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tel: (XX) XXXX-XXXX"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="2dp" />

</LinearLayout>