<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/textViewEditItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editar Item de Pedido"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal" />

    <TextView
        android:id="@+id/textViewDialogProdutoCodigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Código: XXXX"
        android:textSize="16sp"
    android:layout_marginBottom="4dp"
    android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/textViewDialogProdutoNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome: Nome do Produto"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Preço de Venda">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextDialogPrecoVenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/textViewPorcentagemAjuste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="end"
        android:text="% Ajuste"
        android:textColor="?attr/colorAccent"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Quantidade">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextDialogQuantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="% Acréscimo (Opcional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextDialogAcrescimo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="% Desconto (Opcional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextDialogDesconto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/textViewDialogSubtotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Subtotal do Item: R$ 0.00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="24dp"
        android:gravity="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDialogVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorOnPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDialogSalvar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salvar"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>

</LinearLayout>