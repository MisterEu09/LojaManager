<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/border_rounded_corners">

    <TextView
        android:id="@+id/textViewItemFuncionarioNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        tools:text="Nome do Funcionário" />

    <TextView
        android:id="@+id/textViewItemFuncionarioEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        tools:text="email@empresa.com" />

    <TextView
        android:id="@+id/textViewItemFuncionarioRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="?attr/colorSecondary"
        tools:text="Role: vendedor" />

</LinearLayout>