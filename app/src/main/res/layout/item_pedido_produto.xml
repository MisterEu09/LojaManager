<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/rounded_border"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewItemNomeProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do Produto Adicionado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" /> <TextView
        android:id="@+id/textViewItemCodigoProduto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cód: XXXX"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textViewItemQuantidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qtd: 1"
                android:textSize="14sp"
                android:textStyle="italic"
                android:layout_marginEnd="16dp"
                android:textColor="?attr/colorOnSurfaceVariant" /> <TextView
            android:id="@+id/textViewItemPrecoUnitario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preço Unit: R$ 0.00"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="?attr/colorOnSurfaceVariant" /> </LinearLayout>

        <TextView
            android:id="@+id/textViewItemSubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtotal: R$ 0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" android:layout_marginTop="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <ImageView
            android:id="@+id/imageViewEditItem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_edit"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar Item"
            android:layout_marginBottom="8dp"
            app:tint="?attr/colorPrimary" /> <ImageView
        android:id="@+id/imageViewDeleteItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_delete"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remover Item"
        app:tint="?attr/colorError" /> </LinearLayout>
</LinearLayout>