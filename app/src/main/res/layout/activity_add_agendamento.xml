<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="?android:attr/colorBackground" tools:context=".AddAgendamentoActivity">

<LinearLayout
android:id="@+id/toolbarLayoutAddAgendamento"
android:layout_width="match_parent"
android:layout_height="?attr/actionBarSize"
android:background="?attr/colorPrimary"
android:gravity="center_vertical"
android:orientation="horizontal"
app:layout_constraintTop_toTopOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<ImageView
android:id="@+id/imageViewBackAddAgendamento"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginStart="16dp"
android:src="@drawable/ic_arrow_back"
app:tint="?attr/colorOnPrimary"
android:contentDescription="Voltar" />

<TextView
android:id="@+id/textViewToolbarTitleAddAgendamento"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:text="Novo Agendamento de Entrega"
android:textColor="?attr/colorOnPrimary"
android:textSize="20sp"
android:textStyle="bold"
android:gravity="center"
android:layout_marginEnd="16dp" />
</LinearLayout>

<LinearLayout
android:layout_width="match_parent"
android:layout_height="0dp"
android:orientation="vertical"
android:padding="16dp"
app:layout_constraintTop_toBottomOf="@id/toolbarLayoutAddAgendamento"
app:layout_constraintBottom_toBottomOf="parent">
    layoutSelectDeliveryDate
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Cliente (Obrigatório)"
android:layout_marginBottom="4dp"
android:textSize="16sp"
android:textColor="?attr/colorOnBackground" />

<LinearLayout
android:id="@+id/layoutSelectClient"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:background="@drawable/rounded_border"
android:padding="12dp"
android:gravity="center_vertical"
android:layout_marginBottom="16dp">

<TextView
android:id="@+id/textViewSelectedClient"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:text="Selecione o Cliente"
android:textSize="16sp"
android:textColor="?attr/colorOnSurfaceVariant" />

<ImageView
android:layout_width="24dp"
android:layout_height="24dp"
android:src="@drawable/ic_arrow_right"
app:tint="?attr/colorOnSurfaceVariant"
android:contentDescription="Selecionar Cliente" />
</LinearLayout>

<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Data de Entrega Prevista (Obrigatório)"
android:layout_marginBottom="4dp"
android:textSize="16sp"
android:textColor="?attr/colorOnBackground" />

<LinearLayout
android:id="@+id/layoutSelectDeliveryDate"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:background="@drawable/rounded_border"
android:padding="12dp"
android:gravity="center_vertical"
android:layout_marginBottom="16dp">

<TextView
android:id="@+id/textViewSelectedDeliveryDate"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:text="Selecione a Data"
android:textSize="16sp"
android:textColor="?attr/colorOnSurfaceVariant" />

<ImageView
android:layout_width="24dp"
android:layout_height="24dp"
android:src="@drawable/ic_event"
app:tint="?attr/colorOnSurfaceVariant"
android:contentDescription="Selecionar Data" />
</LinearLayout>

<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="16dp"
app:hintEnabled="true"
app:hintAnimationEnabled="true"
android:hint="Observações (Opcional)">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/editTextObservacoesAgendamento"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="textMultiLine"
android:lines="3"
android:gravity="top"
android:textColor="?attr/colorOnSurface" />
</com.google.android.material.textfield.TextInputLayout>

<Button
android:id="@+id/buttonSaveAgendamento"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Salvar Agendamento"
android:layout_marginTop="16dp"
android:padding="12dp"
android:textSize="18sp"
android:textStyle="bold"
android:backgroundTint="?attr/colorPrimary"
android:textColor="?attr/colorOnPrimary" />

</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>