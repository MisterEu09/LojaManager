<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".DataManagementActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarData"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIcon="@drawable/abc_ic_ab_back_material"
            app:title="Gerenciamento de Dados"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayoutData"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gerenciamento de Dados"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnBackground"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Importar Dados (CSV)"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card_background"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecione o tipo de dado para importar:"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerImportType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="@drawable/border_rounded_corners"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/buttonSelectCsv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecionar Arquivo CSV"
                    android:background="@drawable/rounded_button_background_secondary"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/textViewSelectedFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nenhum arquivo selecionado"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/buttonImportData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Importar Dados do Arquivo"
                    android:background="@drawable/rounded_button_background"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:textSize="18sp"
                    android:enabled="false"/>

                <TextView
                    android:id="@+id/textViewPasteInstructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ou cole o conteúdo do CSV abaixo:"
                    android:layout_marginTop="24dp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextCsvContent"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:gravity="top|start"
                    android:hint="Cole o conteúdo do seu CSV aqui..."
                    android:background="@drawable/border_rounded_corners"
                    android:inputType="textMultiLine"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/buttonImportFromText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Importar do Texto Colado"
                    android:background="@drawable/rounded_button_background"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:textSize="18sp"
                    android:enabled="false" />

                <ProgressBar
                    android:id="@+id/progressBarImport"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/textViewImportStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text=""/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exportar Dados (CSV)"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card_background"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecione o tipo de dado para exportar:"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerExportType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="@drawable/border_rounded_corners"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/buttonExportData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exportar Dados"
                    android:background="@drawable/rounded_button_background"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:textSize="18sp"/>

            </LinearLayout>

            <Button
                android:id="@+id/buttonHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Como Montar as Planilhas (Vídeo Tutorial)"
                android:background="@drawable/rounded_button_background_secondary"
                android:textColor="@android:color/white"
                android:padding="12dp"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>